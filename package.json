{
  "name": "gogon",
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "db:populate": "node scripts/populate_db.mjs",
    "reconcile:preflight": "node scripts/reconciliation/preflight.mjs",
    "reconcile:manifest": "node scripts/reconciliation/preflight.mjs --write",
    "test": "node --import ./tests/helpers/no-network.mjs --import ./tests/helpers/test-database.mjs --experimental-test-module-mocks --test \"tests/auth-session/*.test.mjs\" \"tests/control-plane/*.test.mjs\" \"tests/data-storage/*.test.mjs\" \"tests/discord-integration/*.test.mjs\" \"tests/game-monitors/*.test.mjs\" \"tests/health-metrics/*.test.mjs\" \"tests/task-engine/*.test.mjs\"",
    "test:reconciliation": "node --import ./tests/helpers/no-network.mjs --import ./tests/helpers/test-database.mjs --experimental-test-module-mocks --test \"tests/reconciliation/*.test.mjs\""
  },
  "description": "Headless Firefox Browser to run Fallensword notifications and commands on discord",
  "main": "engine.js",
  "keywords": [],
  "author": "CrazyWest Notifications INC",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.1.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "fetch-cookie": "^3.1.0",
    "linkedom": "^0.18.12",
    "mysql2": "^3.24.4",
    "node-fetch": "^3.3.2",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {}
}
