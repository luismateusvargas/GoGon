# GoGon configuration template (CTRL-TASK-001). Copy to .env and fill in real values.
# Generated from config/registry.mjs by scripts/control-plane/write-env-example.mjs; do not edit by hand.
# Legacy SWS_/FS_ names still work as fallbacks, but GG_ names win.
# reloadMode: hot = dashboard change applies next run; subsystem-rebind = restarts that subsystem;
# controlled-session-switch = use dashboard account profiles; bootstrap = .env only.

# --- Game account ---
# Game account email. Bootstrap login when no account profile is active. Change it through Account profiles. [secret, controlled-session-switch]
GG_EMAIL=your_email@example.com
# Game account password. Bootstrap login when no account profile is active. Change it through Account profiles. [secret, controlled-session-switch]
GG_PASSWORD=your_game_password
# Bot character name. Character that casts buffs and uses BE potions. [private, hot]
GG_BOT_CHARACTER=YourBotName
# Bot character ID. Numeric player ID of the bot character. [private, hot]
GG_BOT_ID_CHARACTER=123456
# Guild name. Your guild name, shown in conflict score titles. [public, hot, default My Guild]
# GG_GUILD_NAME=My Guild

# --- Game session ---
# User-Agent. User-Agent sent to the game. Empty uses the built-in browser UA. [public, hot]
# GG_UA=
# Accept-Language. Accept-Language sent to the game. [public, hot]
# GG_LANG=
# Game base URL. Game origin. [public, bootstrap, default https://www.fallensword.com]
# GG_BASE=https://www.fallensword.com
# SSO entry URL. HuntedCow SSO entry point. [public, bootstrap, default https://account.huntedcow.com/auth?game=6]
# GG_SSO_URL=https://account.huntedcow.com/auth?game=6

# --- Discord bot ---
# Discord bot token. Bot token. Saving it restarts only the Discord client. [secret, subsystem-rebind]
GG_DISCORD_TOKEN=your_discord_bot_token
# Discord application ID. Application that owns the slash commands. [private, subsystem-rebind]
GG_DISCORD_APP_ID=123456789012345678
# Discord server ID. Server where slash commands are registered. [private, subsystem-rebind]
GG_DISCORD_GUILD_ID=123456789012345678

# --- Webhooks ---
# Relics. Discord webhook for relics notifications. [secret, hot]
# GG_RELIC_WEBHOOK=
# Guild conflicts. Discord webhook for guild conflicts notifications. [secret, hot]
# GG_CONFLICT_WEBHOOK=
# Bounty board. Discord webhook for bounty board notifications. [secret, hot]
# GG_BOUNTY_WEBHOOK=
# Titans. Discord webhook for titans notifications. [secret, hot]
# GG_TITAN_WEBHOOK=
# Ladder. Discord webhook for ladder notifications. [secret, hot]
# GG_LADDER_WEBHOOK=
# Ladder ranking. Discord webhook for ladder ranking notifications. [secret, hot]
# GG_LADDER_RANKING_WEBHOOK=
# Super Elites. Discord webhook for super elites notifications. [secret, hot]
# GG_SUPER_ELITE_WEBHOOK=
# Crates. Discord webhook for crates notifications. [secret, hot]
# GG_CRATES_WEBHOOK=
# Game updates. Discord webhook for game updates notifications. [secret, hot]
# GG_NEWS_WEBHOOK=
# Shoutbox. Discord webhook for shoutbox notifications. [secret, hot]
# GG_SHOUTBOX_WEBHOOK=
# Guild messages. Discord webhook for guild messages notifications. [secret, hot]
# GG_GUILD_MESSAGE_WEBHOOK=

# --- Notifications ---
# Conflict attack ping mention. Who the incoming-attack ping mentions: none, @everyone, or a role ID. When to ping is fixed by AC-MON-007. [private, hot, default @everyone]
# GG_CONFLICT_PING_MENTION=@everyone
# Super Elite. Discord role mentioned on super elite notifications (numeric ID, no <@&>). [private, hot]
# GG_SE_GROUP_ROLE_ID=
# Bounty. Discord role mentioned on bounty notifications (numeric ID, no <@&>). [private, hot]
# GG_BOUNTY_GROUP_ROLE_ID=
# Titan. Discord role mentioned on titan notifications (numeric ID, no <@&>). [private, hot]
# GG_TITAN_GROUP_ROLE_ID=
# Ladder. Discord role mentioned on ladder notifications (numeric ID, no <@&>). [private, hot]
# GG_LADDER_GROUP_ROLE_ID=

# --- Gear swap ---
# Peace gear inventory IDs. Comma-separated inventory IDs equipped outside conflicts. [private, hot]
# GG_PEACE_GEAR_IDS=
# War gear inventory IDs. Comma-separated inventory IDs equipped during conflicts. [private, hot]
# GG_WAR_GEAR_IDS=

# --- Logging and debugging ---
# Login debug snapshots. Save SSO HTML snapshots to GG_DEBUG_DIR (may contain account pages). [public, hot, default 0]
# GG_LOGIN_DEBUG=0
# Verbose logging. Log routine LOG() lines (warnings and errors are always logged). [public, hot, default 1]
# GG_DEBUG=1
# Debug dump directory. Where HTML debug dumps are written. [public, bootstrap]
# GG_DEBUG_DIR=
# SQL statement logging. Log every SQL statement. [public, bootstrap, default 0]
# GG_DB_DEBUG=0

# --- Storage ---
# MySQL host. MySQL server host. Docker Compose sets the mysql service. [public, bootstrap, default 127.0.0.1]
# GG_MYSQL_HOST=127.0.0.1
# MySQL port. MySQL server port. [public, bootstrap, default 3306]
# GG_MYSQL_PORT=3306
# MySQL user. MySQL account GoGon connects as. [private, bootstrap, default gogon]
# GG_MYSQL_USER=gogon
# MySQL password. Password of GG_MYSQL_USER (also creates the account in Docker Compose). [secret, bootstrap]
# GG_MYSQL_PASSWORD=
# MySQL database. Database (schema) name. [public, bootstrap, default gogon]
# GG_MYSQL_DATABASE=gogon

# --- Control plane ---
# Loopback probe enabled. Serve the unauthenticated loopback /health probe. [public, bootstrap, default 1]
# GG_HEALTH_CHECK_ENABLED=1
# Probe bind address. The probe always binds to loopback. [public, bootstrap, default 127.0.0.1]
# GG_HEALTH_CHECK_HOST=127.0.0.1
# Probe port. Loopback probe port. [public, bootstrap, default 3000]
# GG_HEALTH_CHECK_PORT=3000
# Control plane enabled. Serve the authenticated dashboard. Docker Compose sets 1. [public, bootstrap, default 0]
# GG_CONTROL_ENABLED=0
# Control plane bind address. 0.0.0.0 only inside a container whose port is published on 127.0.0.1. [public, bootstrap, default 127.0.0.1]
# GG_CONTROL_HOST=127.0.0.1
# Control plane port. Dashboard port (http://127.0.0.1:<port>). [public, bootstrap, default 8787]
# GG_CONTROL_PORT=8787
# Secure session cookie. Set when the dashboard is served over HTTPS. [public, bootstrap, default 0]
# GG_CONTROL_COOKIE_SECURE=0
# Administrator username. Dashboard login name. [private, bootstrap]
GG_ADMIN_USERNAME=owner
# Administrator password hash. scrypt hash; a plaintext password is not accepted. [secret, bootstrap]
# run: node scripts/control-plane/hash-password.mjs
GG_ADMIN_PASSWORD_HASH=
# Session signing secret. Signs dashboard session cookies. [secret, bootstrap]
# run: node scripts/control-plane/generate-secrets.mjs
GG_CONTROL_SESSION_SECRET=
# Encryption key. AES-256-GCM key for account profiles and secret overrides. [secret, bootstrap]
# run: node scripts/control-plane/generate-secrets.mjs
GG_CONTROL_ENCRYPTION_KEY=
# Previous encryption key. Only during key rotation (scripts/control-plane/rotate-key.mjs). [secret, bootstrap]
# GG_CONTROL_ENCRYPTION_KEY_PREVIOUS=
